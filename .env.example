# --- Nugen API ---
NUGEN_API_KEY=
NUGEN_BASE_URL=https://api.nugen.in/inference
NUGEN_ALIGNED_MODEL_ID=
NUGEN_EMBED_MODEL=nugen-flash-embed
# Set to false to force nugen-flash-instruct if the aligned model isn't ready.
NUGEN_USE_ALIGNED=true

# --- Google Earth Engine ---
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=backend/gee-key.json
# Production (Vercel): full service-account JSON as a single-line string.
GEE_KEY_JSON=

# --- NASA FIRMS ---
FIRMS_MAP_KEY=

# --- Supabase ---
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000